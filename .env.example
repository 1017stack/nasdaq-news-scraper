# Database
DATABASE_URL=postgresql://nasdaq_user:nasdaq_pass@localhost:5432/nasdaq_news

# AI/LLM (Get free API key at groq.com)
# Free tier: 1M tokens/day, enough for this project
GROQ_API_KEY=your_groq_api_key_here

# Optional: Together AI (alternative free tier)
# TOGETHER_API_KEY=your_key_here

# Scraping Settings
SCRAPE_INTERVAL_MINUTES=15
MAX_ARTICLES_PER_TICKER=10
ENABLE_AI_SUMMARY=true

# Tickers to track (comma-separated)
TICKERS=QQQ,TQQQ,SQQQ,SOXX,AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,AMD,PLTR,COIN,RIVN,LCID,RKLB,INTC
